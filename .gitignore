.DS_Store

# Owner-only notes (never committed)
docs/mnp_nt.md

# Web UIs (req_001 D-152): dependencies, built assets and generated code are never committed.
# Git holds only web/admin/dist/.gitkeep and web/consumer/dist/.gitkeep, so `go build` works
# without npm.
web/node_modules/
web/*/node_modules/
web/admin/dist/*
!web/admin/dist/.gitkeep
web/consumer/dist/*
!web/consumer/dist/.gitkeep
web/shared/src/api/schema.gen.ts
web/*/coverage/
# Playwright outputs of the browser end-to-end test (web/e2e).
web/e2e/test-results/
web/e2e/playwright-report/
web/e2e/blob-report/
web/e2e/.cache/

# `make build` output
/bin/
